# Copiá este archivo como .env y completá los valores. No subas .env a git.

# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=

# Modelo y esfuerzo para el análisis.
# claude-opus-5-5 (más preciso) · claude-sonnet-5-5 (mitad de precio) · claude-haiku-5-5 (mucho más barato)
NEWS_MODEL=claude-opus-5-5
NEWS_EFFORT=medium

# Creá un bot hablando con @BotFather en Telegram (/newbot) y pegá el token acá
TELEGRAM_BOT_TOKEN=
# Escribile algo a tu bot y corré: python digest.py --get-chat-id
TELEGRAM_CHAT_ID=
